# Reglas de caché para Cloudflare Pages / Netlify (GitHub Pages las ignora).
# Las páginas siempre se revisan; el CSS y JS llevan ?v= así que pueden guardarse más tiempo.
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/*.css
  Cache-Control: public, max-age=604800
/*.js
  Cache-Control: public, max-age=604800
/assets/*
  Cache-Control: public, max-age=2592000
